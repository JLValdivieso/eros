#Put the configuration of the base address

CSR: {
  BaseAddress: 0x20070000  #Base address for internal Control & Status Registers
}

SystemBus: {
  BaseAddress: 0xF0000000  #Base address for OBI system bus
}

MMAcceleratorOrExternalBus: {
  BaseAddress: 0x00000000   #Base address of the accelerator or external bus, in case of MM accelerator use the same base address of the SystemBus + offset check eros package to avoid conflicts
  Size: 0x41000000          # Memory space size
}